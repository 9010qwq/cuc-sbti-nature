{
  "name": "cuc-sbti-nature",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node prepare.mjs && vite --host 127.0.0.1 --configLoader native",
    "build": "node prepare.mjs && tsc --noEmit && vite build --configLoader native && node pack.mjs",
    "build:web": "node prepare.mjs --web && tsc --noEmit && vite build --mode web --configLoader native && node pack-web.mjs",
    "test": "node --experimental-strip-types tests/logic.test.ts && node --experimental-strip-types tests/copy.test.ts",
    "test:browser": "node tests/browser.cjs",
    "test:web": "node tests/online.cjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "^5.2.0"
  },
  "engines": {
    "node": ">=24"
  }
}
